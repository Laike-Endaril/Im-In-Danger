imindanger.config.visuals=Visuals
imindanger.config.dangersenseMode=Dangersense Mode
imindanger.config.dangersenseMode.tooltip=How players can obtain dangersense\nClients must have the same setting as the server in order to function correctly!\n\n0 = Players always have dangersense\n\n1 = Players have dangersense when using a dangersense potion (adds potion items to the world!)\n\n2 = Players have dangersense when using a dangersense enchantment (adds enchantment to the world!)\n\n3 = Players have dangersense when using a dangersense potion or enchantment (adds potion items and an enchantment to the world!)\n \n
imindanger.config.dangerFadeInTime=Danger Fade-In Time
imindanger.config.dangerFadeInTime.tooltip=How long the danger indicator and heartbeat take to fade in when danger is detected, in milliseconds (1000 = 1 second)
imindanger.config.dangerFadeOutTime=Danger Fade-Out Time
imindanger.config.dangerFadeOutTime.tooltip=How long the danger indicator and heartbeat take to fade out when no danger is detected, in milliseconds (1000 = 1 second)


imindanger.config.server.sneakyEntities=Sneaky Entities
imindanger.config.server.sneakyEntities.tooltip=Entities that won't trigger the danger mode (good for surprise attack entities), eg...\nminecraft:skeleton
imindanger.config.server.sneakyPotions=Sneaky Potions
imindanger.config.server.sneakyPotions.tooltip=If an entity has one of these potions active, they will not trigger the danger mode, eg...\nminecraft:invisibility

imindanger.config.sound.alertVolume=Alert Volume
imindanger.config.sound.alertVolume.tooltip=How loud the alert sound is
imindanger.config.sound.minTimeBetweenAlarms=Minimum Time Between Alarms
imindanger.config.sound.minTimeBetweenAlarms.tooltip=After the alarm sound plays, at least this much time needs to go by before it can play again, in milliseconds (1000 = 1 second)
imindanger.config.sound.heartbeatVolume=Heartbeat Volume
imindanger.config.sound.heartbeatVolume.tooltip=How loud the heartbeat sound is
imindanger.config.sound.quietHeartbeatDelay=Quiet Heartbeat Delay
imindanger.config.sound.quietHeartbeatDelay.tooltip=This amount of time after danger is encountered, the heartbeat gets quieter; -1 means never, 1000 is 1 second
imindanger.config.sound.quietHeartbeatVolume=Quiet Heartbeat Volume
imindanger.config.sound.quietHeartbeatVolume.tooltip=How loud the heartbeat sound is when it gets quieter
imindanger.config.sound.maxHeartbeatDuration=Max Heartbeat Duration
imindanger.config.sound.maxHeartbeatDuration.tooltip=Limits how long the heartbeat will play when in danger, in milliseconds; -1 means no limit, 1000 is 1 second

imindanger.config.visuals.dangerIndicatorType=Danger Indicator Type
imindanger.config.visuals.dangerIndicatorType.tooltip=What kind of danger indicator is shown when in danger\n0 = None\n1 = Regular Image
imindanger.config.visuals.dangerIndicatorXPosition=Danger Indicator X Position
imindanger.config.visuals.dangerIndicatorXPosition.tooltip=The horizontal location of the danger indicator (0 = left, 0.5 = center, 1 = right)
imindanger.config.visuals.dangerIndicatorYPosition=Danger Indicator Y Position
imindanger.config.visuals.dangerIndicatorYPosition.tooltip=The vertical location of the danger indicator (0 = left, 0.5 = center, 1 = right)
imindanger.config.visuals.dangerIndicatorScale=Danger Indicator Scale
imindanger.config.visuals.dangerIndicatorScale.tooltip=The damage indicator size is multiplied by this amount\nNote that render size has nothing to do with original image file dimensions (but image quality does)
